# hybrid_input example
# Lines starting with # or // are ignored.

# Simulation control
njob = 0
Nev = 100
cent = 0-5
#pythia_cmnd = setup_pythia.cmnd
#max_tree_attempts = 100000
#max_event_attempts = 1000000

# Energy loss parameters
kappa = 15.0
alpha = 0.404

tmethod = 0
mode = 0

# MMLHI inherits the full MMLI light-parton path. Its sole intended physics
# specialization is that charm and bottom remain in transport instead of taking
# MMLI's early free-stream return. Mode 0 disables the dedicated heavy kernel,
# but charm/bottom still use the inherited continuous-loss loop with mass floors.
# heavy_quark_eloss_mode = 0: disabled
# heavy_quark_eloss_mode = 1: heavy drag / light-HYBRID crossover
# heavy_quark_eloss_mode = 2: mode 1 plus heavy-quark diffusion
# heavy_quark_eloss_mode = 3: heavy-quark diffusion only
# Modes 1 and 2 require the strong-coupling HYBRID setting mode=0.
# The legacy coupling convention is kappa_HQ = pi*sqrt(heavy_quark_lambda).
# The charm/bottom mass settings are lower invariant-mass floors. The kernel
# keeps a larger live shower mass (PYTHIA 8.315 defaults to m0=1.50/4.80 GeV).
# Mode 1 retains generic kappa broadening. In modes 2 and 3, the first Boolean
# below selects additive generic broadening (true, compatibility default) or
# suppresses it (false, no-overlap diagnostic setting). Neither choice is yet
# a complete soft-matching prescription for mode 2.
#heavy_quark_eloss_mode = 0
#heavy_quark_lambda = 0.0
#heavy_quark_charm_mass = 1.25
#heavy_quark_bottom_mass = 4.2
#heavy_quark_add_generic_broadening_with_diffusion = true
# Hard charm uses an inherited massless Moliere sampler and is not recommended
# for physics production. Bottom hard Moliere is always disabled.
#heavy_quark_enable_hard_moliere = true

# Physics toggles
# Light quarks/gluons follow MMLI exactly; MMLHI supplies massive charm/bottom transport.
# do_quench: true/false
# do_wake: true/false
# do_source: true/false
# do_elastic: true/false (Moliere elastic scattering integration path)
# do_lres: true/false (finite color-resolution energy-loss path)
# do_Moliere_on_unresolved_partons: true applies Moliere to individual unresolved daughters.
#                                   false keeps the default unresolved-effective-object scattering.
# do_Moliere_dynamic_unresolved_resolution: true tests each parent-candidate unresolved hard
#                                           Moliere scattering with q_perp*d_perp >
#                                           moliere_unresolved_resolution_c.
#                                           This takes precedence over do_Moliere_on_unresolved_partons.
# do_Moliere_dynamic_daughter_unresolved_resolution: true generates candidate scatterings from
#                                                    daughter-level attempts before the same
#                                                    q_perp*d_perp test. This takes precedence
#                                                    over the parent-candidate dynamic mode.
# do_Moliere_recursive_unresolved_resolution: true recursively probes the finest
#                                             formed colored constituents. A resolving
#                                             daughter candidate acts on that branch; a
#                                             fully unresolved daughter candidate is
#                                             discarded. The active colored coherent
#                                             object is then sampled with its own rate
#                                             until an unresolving candidate is found or
#                                             the LRES interval ends. Color-neutral
#                                             coherent objects cannot receive a hard kick.
#                                             This takes precedence over all other
#                                             unresolved Moliere modes. Mode E is
#                                             validation-only until live-parent opening
#                                             conserves four-momentum. Running it requires
#                                             explicit acknowledgement plus a residual cap.
# allow_modee_nonconserving_opening: must be true to run diagnostic Mode E.
# modee_max_opening_relative_residual: abort when |sum p_daughter-p_parent|/E_parent
#                                      exceeds this value (default 1e-6).
# moliere_unresolved_resolution_c: O(1) threshold on the dimensionless lab-frame test
#                                  q_perp[GeV]*d_perp[fm]/(hbar*c), where d_perp is
#                                  transverse to the incoming scattering-source direction.
# dump_hybrid_evolution_history: write time-ordered LRES/Moliere/response records for event-display plots.
# hybrid_evolution_history_file: output TSV path for those records (append mode).
# doEventDisplay: write a ROOT TTree with one row per propagated parton time segment.
# eventDisplayFile: output ROOT file used when doEventDisplay=true.
# compat_moliere_legacy_hydro: true preserves exact Moliere_code averaged-hydro interpolation.
# Set false to use unified MMI HydroProfile access for Moliere elastic.
# use_prehydro: true loads an optional arXiv:2509.19430-style pre-hydro table before tau_hydro.
# prehydro_file: TSV generated by oo_bridge_tools.py generate-attractor-prehydro.

do_quench = true
#do_wake = true
#do_source = false
#do_elastic = false
#do_lres = false
#do_Moliere_on_unresolved_partons = false
#do_Moliere_dynamic_unresolved_resolution = false
#do_Moliere_dynamic_daughter_unresolved_resolution = false
#do_Moliere_recursive_unresolved_resolution = false
#allow_modee_nonconserving_opening = false
#modee_max_opening_relative_residual = 0.000001
#moliere_unresolved_resolution_c = 1.0
#dump_hybrid_evolution_history = false
#hybrid_evolution_history_file = hybrid_evolution_history.tsv
#doEventDisplay = false
#eventDisplayFile = eventDisplay.root
#compat_moliere_legacy_hydro = true
#use_prehydro = false
#prehydro_file = prehydro_table.tsv
#rpower = 2.0

# Validation-only fixed production vertex. Leave disabled for physics runs.
#use_fixed_xy = false
#fixed_x = 0.0
#fixed_y = 0.0

# Hydro mode: 0 = averaged hydro (Hydro_PbPb), 1 = event-by-event (ipsat)
ebe_hydro = 0

# Medium hadronization mode
# hadro_type = 0 : direct PYTHIA hadronization with existing color tags
# hadro_type = 1 : rebuild strings before hadronization (needed for elastic recoilers)
#hadro_type = 0

# Moliere table directory for elastic mode
#tables_path = /raid5/data/yjlee/hybrid_dev/moliere_table_bundle/a10_tables/

# Output base name (files will be <output_base>_Hadrons.out and <output_base>_Partons.out)
output_base = HYBRID

# Trigger options
# use_trigger: if true, only accept events containing the trigger particle
# trigger_id:  PDG id of trigger particle (e.g. 22 = photon, 23 = Z)
# trigger_pt:  minimum pT of trigger particle (GeV)
# trigger_eta: maximum |eta| of trigger particle
#use_trigger = false
#trigger_id = 22
#trigger_pt = 20.0
#trigger_eta = 2.4
